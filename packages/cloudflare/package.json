{
	"name": "@ambionframework/cloudflare",
	"version": "0.1.0-alpha.1",
	"type": "module",
	"description": "A room as Cloudflare Durable Objects: one object per room, one per seat.",
	"license": "Apache-2.0",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=26.4.0"
	},
	"scripts": {
