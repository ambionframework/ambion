{
	"name": "ambion-cloudflare",
	// The workerd tier's worker: it configures the catalog and exports the two objects.
	"main": "test/worker.ts",
	// The date the test pool's workerd supports. Newer than the binary refuses to start.
	"compatibility_date": "2026-08-15",
	"compatibility_flags": ["nodejs_compat"],
	"durable_objects": {
		"bindings": [
			{ "name": "ROOM", "class_name": "RoomObject" },
			{ "name": "SEAT", "class_name": "SeatObject" }
		]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject", "SeatObject"] }]
}
