{
	"name": "@ambionframework/codex",
	"version": "0.7.0",
	"type": "module",
	"description": "The Codex SDK executor for Ambion rooms: codex() agents and codexExecution().",
	"license": "Apache-2.0",
	"homepage": "https://ambionframework.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ambionframework/ambion.git",
		"directory": "packages/codex"
	},
	"keywords": [
		"ambion",
		"codex",
		"executor",
		"agents"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"check:types": "tsc -p tsconfig.check.json --noEmit",
		"test": "vitest run",
		"test:live": "tsdown && vitest run --config vitest.live.config.ts",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@ambionframework/ambion": "workspace:*",
		"@ambionframework/compose": "workspace:*",
		"@openai/codex": "0.160.1"
	},
	"devDependencies": {
		"@ambionframework/journal": "workspace:*",
		"@ambionframework/just-bash": "workspace:*",
		"@ambionframework/pi": "workspace:*",
		"@ambionframework/workspace": "workspace:*",
		"tsdown": "^0.23.0",
		"typebox": "^1.3.36",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	}
}
