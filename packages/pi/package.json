{
	"name": "@ambionframework/pi",
	"version": "0.1.0",
	"type": "module",
	"description": "The Pi executor for Ambion rooms: pi() agents, piExecution(), and the seat transcript audit.",
	"license": "Apache-2.0",
	"homepage": "https://ambionframework.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ambionframework/ambion.git",
		"directory": "packages/pi"
	},
	"keywords": [
		"ambion",
		"pi",
		"executor",
		"agents"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./testing": {
			"types": "./dist/testing.d.mts",
			"import": "./dist/testing.mjs"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"check:types": "tsc -p tsconfig.check.json --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@ambionframework/ambion": "workspace:*",
		"@ambionframework/journal": "workspace:*",
		"@earendil-works/pi-agent-core": "^0.85.1",
		"@earendil-works/pi-ai": "^0.85.1",
		"typebox": "^1.3.18"
	},
	"devDependencies": {
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	}
}
