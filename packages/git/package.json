{
	"name": "@ambionframework/git",
	"version": "0.2.0",
	"type": "module",
	"description": "A git backend for an Ambion workspace: read-only templates, forks, and pushes, over an in-process just-git server.",
	"license": "Apache-2.0",
	"homepage": "https://ambionframework.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ambionframework/ambion.git",
		"directory": "packages/git"
	},
	"keywords": [
		"agents",
		"ambion",
		"git",
		"just-git",
		"templates",
		"workspace"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"README.md"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"check:types": "tsc -p tsconfig.check.json --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@ambionframework/workspace": "workspace:*",
		"just-git": "^1.8.2"
	},
	"devDependencies": {
		"@ambionframework/just-bash": "workspace:*",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	}
}
