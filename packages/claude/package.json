{
	"name": "@ambionframework/claude",
	"version": "0.7.0",
	"type": "module",
	"description": "The Claude Agent SDK executor for Ambion rooms: claude() agents and claudeExecution().",
	"license": "Apache-2.0",
	"homepage": "https://ambionframework.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ambionframework/ambion.git",
		"directory": "packages/claude"
	},
	"keywords": [
		"ambion",
		"claude",
		"executor",
		"agents"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./testing": {
			"types": "./dist/testing.d.mts",
			"import": "./dist/testing.mjs"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"check:types": "tsc -p tsconfig.check.json --noEmit",
		"test": "vitest run",
		"test:live": "pnpm --filter '@ambionframework/claude...' build && vitest run --config vitest.live.config.ts",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@ambionframework/ambion": "workspace:*",
		"@ambionframework/compose": "workspace:*",
		"@anthropic-ai/claude-agent-sdk": "0.3.291",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@ambionframework/journal": "workspace:*",
		"@ambionframework/just-bash": "workspace:*",
		"@ambionframework/pi": "workspace:*",
		"@ambionframework/workspace": "workspace:*",
		"tsdown": "^0.23.0",
		"typebox": "^1.3.36",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	}
}
