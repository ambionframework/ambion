{
	"name": "@ambionframework/workspace",
	"version": "0.4.0",
	"type": "module",
	"description": "A workspace for Ambion: the workspace port, the tools an agent uses on it, and an optional SQLite database.",
	"license": "Apache-2.0",
	"homepage": "https://ambionframework.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ambionframework/ambion.git",
		"directory": "packages/workspace"
	},
	"keywords": [
		"agents",
		"ambion",
		"filesystem",
		"sandbox",
		"workspace"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./resource": {
			"types": "./dist/resource-entry.d.mts",
			"import": "./dist/resource-entry.mjs"
		},
		"./sqlite": {
			"types": "./dist/sqlite-entry.d.mts",
			"import": "./dist/sqlite-entry.mjs"
		},
		"./git": {
			"types": "./dist/git-entry.d.mts",
			"import": "./dist/git-entry.mjs"
		},
		"./s3": {
			"types": "./dist/s3-entry.d.mts",
			"import": "./dist/s3-entry.mjs"
		},
		"./conformance": {
			"types": "./dist/conformance.d.mts",
			"import": "./dist/conformance.mjs"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"README.md"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"check:types": "tsc -p tsconfig.check.json --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:live": "vitest run --config vitest.live.config.ts",
		"test:s3": "vitest run --config vitest.s3.config.ts"
	},
	"devDependencies": {
		"@ambionframework/pi": "workspace:*",
		"@earendil-works/pi-ai": "^0.87.1",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@ambionframework/ambion": "workspace:*",
		"@earendil-works/pi-agent-core": "^0.87.1",
		"aws4fetch": "^1.0.20",
		"typebox": "^1.3.34",
		"yaml": "^2.9.1"
	}
}
