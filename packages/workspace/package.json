{
	"name": "@ambionframework/workspace",
	"version": "0.0.0",
	"type": "module",
	"description": "A workspace backend for Ambion: a virtual Unix filesystem and shell, in memory or over a directory.",
	"license": "Apache-2.0",
	"homepage": "https://ambionframework.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ambionframework/ambion.git",
		"directory": "packages/workspace"
	},
	"keywords": [
		"agents",
		"ambion",
		"filesystem",
		"sandbox",
		"workspace"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"README.md"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"check:types": "tsc -p tsconfig.check.json --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:live": "vitest run --config vitest.live.config.ts"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^0.84.3",
		"tsdown": "^0.22.14",
		"typebox": "^1.3.18",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@ambionframework/ambion": "workspace:*",
		"@earendil-works/pi-agent-core": "^0.84.3",
		"just-bash": "^3.4.2"
	}
}
