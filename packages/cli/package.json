{
	"name": "@ambionframework/cli",
	"version": "0.1.0-alpha.1",
	"type": "module",
	"description": "The Ambion command line: ambion new creates a project and ambion dev opens its rooms.",
	"license": "Apache-2.0",
	"homepage": "https://ambionframework.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ambionframework/ambion.git",
		"directory": "packages/cli"
	},
	"keywords": [
		"ambion",
		"agents",
		"cli"
	],
	"bin": {
		"ambion": "bin/ambion.mjs"
	},
	"files": [
		"bin/ambion.mjs",
		"dist",
		"templates"
	],
	"engines": {
		"node": ">=26.4.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"check:types": "tsc --noEmit && tsc --noEmit -p tsconfig.template.cloudflare.json && tsc --noEmit -p tsconfig.template.node.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@ambionframework/ambion": "workspace:*",
		"@opentui/core": "0.5.11"
	},
	"devDependencies": {
		"@ambionframework/cloudflare": "workspace:*",
		"@ambionframework/journal": "workspace:*",
		"@ambionframework/pi": "workspace:*",
		"@cloudflare/workers-types": "5.20260910.1",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	}
}
