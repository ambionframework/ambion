{
	"name": "ambion-node",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.20.0",
	"type": "module",
	"ambion": {
		"template": "node"
	},
	"description": "A small Ambion team that runs in one Node process and keeps its record in SQLite.",
	"scripts": {
		"dev": "ambion dev",
		"start": "node --env-file-if-exists=.env src/main.ts",
		"check:types": "tsc --noEmit"
	},
	"dependencies": {
		"@ambionframework/ambion": "0.0.0",
		"@ambionframework/journal": "0.0.0",
		"@ambionframework/pi": "0.0.0"
	},
	"devDependencies": {
		"@ambionframework/cli": "0.0.0",
		"@types/node": "26.2.0",
		"typescript": "7.0.2"
	}
}
