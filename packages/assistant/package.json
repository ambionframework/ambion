{
	"name": "@ambionframework/assistant",
	"version": "0.6.0",
	"type": "module",
	"description": "A reusable assistant definition for Ambion rooms.",
	"license": "Apache-2.0",
	"homepage": "https://ambionframework.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ambionframework/ambion.git",
		"directory": "packages/assistant"
	},
	"keywords": [
		"agents",
		"ambient",
		"collaboration",
		"framework"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"check:types": "tsc --noEmit",
		"test": "vitest run",
		"test:live": "pnpm --filter '@ambionframework/assistant^...' build && vitest run --config vitest.live.config.ts"
	},
	"dependencies": {
		"@ambionframework/ambion": "workspace:*"
	},
	"devDependencies": {
		"@ambionframework/claude": "workspace:*",
		"@ambionframework/codex": "workspace:*",
		"@ambionframework/journal": "workspace:*",
		"@ambionframework/pi": "workspace:*",
		"@ambionframework/simulator": "workspace:*",
		"@earendil-works/pi-ai": "^1.0.0",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	}
}
