{
	"name": "@ambionframework/just-bash",
	"version": "0.1.0",
	"type": "module",
	"description": "The just-bash backends for an Ambion workspace: a virtual Unix filesystem and shell, in memory or over a directory.",
	"license": "Apache-2.0",
	"homepage": "https://ambionframework.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ambionframework/ambion.git",
		"directory": "packages/just-bash"
	},
	"keywords": [
		"agents",
		"ambion",
		"filesystem",
		"just-bash",
		"sandbox",
		"workspace"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"README.md"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"check:types": "tsc -p tsconfig.check.json --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@ambionframework/workspace": "workspace:*",
		"@earendil-works/pi-agent-core": "^0.85.1",
		"just-bash": "^3.4.2"
	},
	"devDependencies": {
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	}
}
