{
	"name": "@ambionframework/canvas",
	"version": "0.6.0",
	"type": "module",
	"description": "The canvas store: one durable row for each room of a deployment, in memory or in SQLite.",
	"license": "Apache-2.0",
	"homepage": "https://ambionframework.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ambionframework/ambion.git",
		"directory": "packages/canvas"
	},
	"keywords": [
		"ambion",
		"canvas",
		"rooms",
		"store"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./conformance": {
			"types": "./dist/conformance.d.mts",
			"import": "./dist/conformance.mjs"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"README.md"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"check:types": "tsc -p tsconfig.check.json --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@ambionframework/ambion": "workspace:*",
		"@ambionframework/journal": "workspace:*",
		"@ambionframework/workspace": "workspace:*"
	},
	"devDependencies": {
		"@ambionframework/just-bash": "workspace:*",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	}
}
