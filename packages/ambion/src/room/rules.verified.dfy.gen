function contributionMatches(activation: string, seat: string, intent: Contribution, to: Option<string>, message: Recorded): bool
{
  if !(namedAs(message.activationId, activation)) then
    false
  else
    if !(namedAs(message.from, seat)) then
      false
    else
      match intent {
        case seated(i_intent_name) =>
          sameMembership(message.kind, message.subject, MessageKind.seated, i_intent_name)
        case unseated(i_intent_name) =>
          sameMembership(message.kind, message.subject, MessageKind.unseated, i_intent_name)
        case said(i_intent_text) =>
          if message.kind.said? then
            (sameName(message.to, to) && (message.text == i_intent_text))
          else
            if (!message.kind.summary?) then
              false
            else
              match to {
                case Some(i_to_val) =>
                  if !(namedAs(message.to, i_to_val)) then
                    false
                  else
                    (message.text == i_intent_text)
                case None =>
                  (message.text == i_intent_text)
              }
      }
}

lemma contributionMatches_ensures(activation: string, seat: string, intent: Contribution, to: Option<string>, message: Recorded)
  ensures (contributionMatches(activation, seat, intent, to, message) ==> namedAs(message.activationId, activation))
  ensures (contributionMatches(activation, seat, intent, to, message) ==> namedAs(message.from, seat))
  ensures ((match message.activationId { case Some(i_) => false case None => true }) ==> !(contributionMatches(activation, seat, intent, to, message)))
  ensures ((message.kind.arrived? || message.kind.left?) ==> !(contributionMatches(activation, seat, intent, to, message)))
  ensures (intent.seated? ==> (contributionMatches(activation, seat, intent, to, message) <==> (((namedAs(message.activationId, activation) && namedAs(message.from, seat)) && message.kind.seated?) && namedAs(message.subject, intent.name))))
  ensures (intent.unseated? ==> (contributionMatches(activation, seat, intent, to, message) <==> (((namedAs(message.activationId, activation) && namedAs(message.from, seat)) && message.kind.unseated?) && namedAs(message.subject, intent.name))))
  ensures (intent.said? ==> message.kind.said? ==> (contributionMatches(activation, seat, intent, to, message) <==> (((namedAs(message.activationId, activation) && namedAs(message.from, seat)) && sameName(message.to, to)) && (message.text == intent.text))))
  ensures (intent.said? ==> message.kind.summary? ==> (match to { case Some(i_) => false case None => true }) ==> (contributionMatches(activation, seat, intent, to, message) <==> ((namedAs(message.activationId, activation) && namedAs(message.from, seat)) && (message.text == intent.text))))
  ensures (match to { case Some(i_to_val) => (intent.said? ==> message.kind.summary? ==> (contributionMatches(activation, seat, intent, to, message) <==> (((namedAs(message.activationId, activation) && namedAs(message.from, seat)) && namedAs(message.to, i_to_val)) && (message.text == intent.text)))) case None => true })
  ensures (intent.said? ==> (!message.kind.said?) ==> (!message.kind.summary?) ==> !(contributionMatches(activation, seat, intent, to, message)))
  ensures (contributionMatches(activation, seat, intent, to, message) ==> intent.said? ==> (message.text == intent.text))
{
}

method latest(times: seq<int>, floor: int) returns (res: int)
  requires (floor >= 0)
  ensures (res >= floor)
  ensures forall i: int :: ((0 <= i) ==> (i < |times|) ==> (res >= times[i]))
{
  var best := floor;
  var i := 0;
  while (i < |times|)
    invariant (0 <= i)
    invariant (i <= |times|)
    invariant (best >= floor)
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> (best >= times[k]))
  {
    var v := (if ((0 <= i) && (i < |times|)) then times[i] else floor);
    if (v > best) {
      best := v;
    }
    i := (i + 1);
  }
  return best;
}

method forgets(sentIds: seq<string>, dueIds: seq<string>) returns (res: seq<string>)
  ensures (|res| <= |sentIds|)
  ensures forall i: int :: ((0 <= i) ==> (i < |res|) ==> !((res[i] in dueIds)))
  ensures forall i: int :: ((0 <= i) ==> (i < |res|) ==> (res[i] in sentIds))
  ensures forall i: int :: ((0 <= i) ==> (i < |sentIds|) ==> !((sentIds[i] in dueIds)) ==> (sentIds[i] in res))
  ensures forall i: int :: ((0 <= i) ==> (i < |dueIds|) ==> !((dueIds[i] in res)))
{
  var out: seq<string> := [];
  var i := 0;
  while (i < |sentIds|)
    invariant (0 <= i)
    invariant (i <= |sentIds|)
    invariant (|out| <= i)
    invariant forall k: int :: ((0 <= k) ==> (k < |out|) ==> !((out[k] in dueIds)))
    invariant forall k: int :: ((0 <= k) ==> (k < |out|) ==> (out[k] in sentIds))
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> !((sentIds[k] in dueIds)) ==> (sentIds[k] in out))
    decreases (|sentIds| - i)
  {
    var id := (if ((0 <= i) && (i < |sentIds|)) then sentIds[i] else "");
    if !((id in dueIds)) {
      out := (out + [id]);
    }
    i := (i + 1);
  }
  return out;
}

method foldPresence(entries: seq<PresenceEntry>) returns (res: map<string, Person>)
  ensures forall n :: ((n in res) ==> (present(Some(res[n])) <==> exists k: int :: (((((0 <= k) && (k < |entries|)) && (entries[k].name == n)) && entries[k].kind.arrived?) && forall j: int :: ((k < j) ==> (j < |entries|) ==> (entries[j].name == n) ==> (!entries[j].kind.left?)))))
  ensures forall k: int :: ((0 <= k) ==> (k < |entries|) ==> entries[k].kind.arrived? ==> (entries[k].name in res))
{
  var people: map<string, Person> := map[];
  var i := 0;
  while (i < |entries|)
    invariant (0 <= i)
    invariant (i <= |entries|)
    invariant forall n :: ((n in people) ==> (present(Some(people[n])) <==> exists k: int :: (((((0 <= k) && (k < i)) && (entries[k].name == n)) && entries[k].kind.arrived?) && forall j: int :: ((k < j) ==> (j < i) ==> (entries[j].name == n) ==> (!entries[j].kind.left?)))))
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> entries[k].kind.arrived? ==> (entries[k].name in people))
  {
    var entry := entries[i];
    var i_t0 := stepPerson((if entry.name in people then Some(people[entry.name]) else None), entry);
    var next := i_t0;
    match next {
      case Some(i_next_val) =>
        people := people[entry.name := i_next_val];
      case None =>

    }
    i := (i + 1);
  }
  return people;
}

method discussion(messages: seq<Message>, from: int, through: int) returns (res: seq<Message>)
  ensures forall i: int :: ((0 <= i) ==> (i < |res|) ==> (((res[i].kind != "summary") && (from <= res[i].seq_)) && (res[i].seq_ <= through)))
  ensures forall k: int :: ((0 <= k) ==> (k < |messages|) ==> (messages[k].kind != "summary") ==> (from <= messages[k].seq_) ==> (messages[k].seq_ <= through) ==> exists i: int :: (((0 <= i) && (i < |res|)) && (res[i] == messages[k])))
  ensures forall i: int :: ((0 <= i) ==> (i < |res|) ==> (res[i] in messages))
  ensures (|res| <= |messages|)
{
  var out: seq<Message> := [];
  var i := 0;
  while (i < |messages|)
    invariant (0 <= i)
    invariant (i <= |messages|)
    invariant (|out| <= i)
    invariant forall m: int :: ((0 <= m) ==> (m < |out|) ==> (((out[m].kind != "summary") && (from <= out[m].seq_)) && (out[m].seq_ <= through)))
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> (messages[k].kind != "summary") ==> (from <= messages[k].seq_) ==> (messages[k].seq_ <= through) ==> exists m: int :: (((0 <= m) && (m < |out|)) && (out[m] == messages[k])))
    invariant forall m: int :: ((0 <= m) ==> (m < |out|) ==> (out[m] in messages))
  {
    var head := messages[i];
    if (((head.kind != "summary") && (head.seq_ >= from)) && (head.seq_ <= through)) {
      ghost var before: seq<Message> := out;
      out := (out + [head]);
      assert forall m: int :: ((0 <= m) ==> (m < |before|) ==> (out[m] == before[m]));
      assert (out[|before|] == head);
    }
    i := (i + 1);
  }
  return out;
}

method messagesSince(messages: seq<Message>, since: int) returns (res: seq<Message>)
  requires forall a: int, b: int :: ((0 <= a) ==> (a < b) ==> (b < |messages|) ==> (messages[a].seq_ < messages[b].seq_))
  ensures (|res| <= |messages|)
  ensures forall i: int :: ((0 <= i) ==> (i < |res|) ==> (res[i].seq_ > since))
  ensures forall i: int :: ((0 <= i) ==> (i < |res|) ==> (res[i] in messages))
  ensures forall k: int :: ((0 <= k) ==> (k < |messages|) ==> (messages[k].seq_ > since) ==> (messages[k] in res))
  ensures forall a: int, b: int :: ((0 <= a) ==> (a < b) ==> (b < |res|) ==> (res[a].seq_ < res[b].seq_))
{
  var out: seq<Message> := [];
  var i := 0;
  while (i < |messages|)
    invariant (0 <= i)
    invariant (i <= |messages|)
    invariant (|out| <= i)
    invariant forall m: int :: ((0 <= m) ==> (m < |out|) ==> (out[m].seq_ > since))
    invariant forall m: int :: ((0 <= m) ==> (m < |out|) ==> (out[m] in messages))
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> (messages[k].seq_ > since) ==> (messages[k] in out))
    invariant forall a: int, b: int :: ((0 <= a) ==> (a < b) ==> (b < |out|) ==> (out[a].seq_ < out[b].seq_))
    invariant forall m: int :: ((0 <= m) ==> (m < |out|) ==> forall k: int :: ((i <= k) ==> (k < |messages|) ==> (out[m].seq_ < messages[k].seq_)))
  {
    var head := messages[i];
    if (head.seq_ > since) {
      ghost var before: seq<Message> := out;
      out := (out + [head]);
      assert forall m: int :: ((0 <= m) ==> (m < |before|) ==> (out[m] == before[m]));
      assert (out[|before|] == head);
    }
    i := (i + 1);
  }
  return out;
}

method exchangeContaining(closes: seq<Range>, open: Option<int>, seq_: int) returns (res: Found)
  ensures (match res { case closed(i_result_from) => exists i: int :: (((((0 <= i) && (i < |closes|)) && inside(closes[i], seq_)) && (closes[i].from == i_result_from)) && forall k: int :: ((0 <= k) ==> (k < i) ==> !(inside(closes[k], seq_)))) case _ => true })
  ensures ((!res.closed?) ==> forall i: int :: ((0 <= i) ==> (i < |closes|) ==> !(inside(closes[i], seq_))))
  ensures ((match open { case Some(i_) => false case None => true }) ==> (!res.open?))
  ensures (match open { case Some(i_open_val) => (res.open? ==> ((i_open_val == res.from) && (res.from <= seq_))) case None => true })
  ensures ((match open { case Some(i_) => false case None => true }) ==> (!res.closed?) ==> res.outside?)
  ensures (match open { case Some(i_open_val) => (res.outside? ==> (i_open_val > seq_)) case None => true })
  ensures (match open { case Some(i_open_val) => ((i_open_val <= seq_) ==> (!res.outside?)) case None => true })
  ensures ((res.closed? || res.open?) ==> (res.from <= seq_))
{
  var i := 0;
  while (i < |closes|)
    invariant (0 <= i)
    invariant (i <= |closes|)
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> !(inside(closes[k], seq_)))
  {
    var close := (if ((0 <= i) && (i < |closes|)) then closes[i] else Range(0, -1));
    var i_t1 := inside(close, seq_);
    if i_t1 {
      return Found.closed(close.from);
    }
    i := (i + 1);
  }
  match open {
    case Some(i_open_val) =>
      if (i_open_val <= seq_) {
        return Found.open(i_open_val);
      }
    case None =>

  }
  return Found.outside;
}

method reserveOf(catalog: seq<Seating>, roster: seq<Seating>) returns (res: seq<Seating>)
  ensures forall i: int :: ((0 <= i) ==> (i < |res|) ==> !(carries(roster, res[i].name)))
  ensures forall i: int :: ((0 <= i) ==> (i < |res|) ==> res[i].attention.broadcast?)
  ensures forall i: int :: ((0 <= i) ==> (i < |res|) ==> fromCatalog(catalog, res[i]))
  ensures forall k: int :: ((0 <= k) ==> (k < |catalog|) ==> (carries(roster, catalog[k].name) || exists i: int :: ((((0 <= i) && (i < |res|)) && (res[i].name == catalog[k].name)) && (res[i].identity == catalog[k].identity))))
  ensures (|res| <= |catalog|)
{
  var out: seq<Seating> := [];
  var i := 0;
  while (i < |catalog|)
    invariant (0 <= i)
    invariant (i <= |catalog|)
    invariant (|out| <= i)
    invariant forall m: int :: ((0 <= m) ==> (m < |out|) ==> !(carries(roster, out[m].name)))
    invariant forall m: int :: ((0 <= m) ==> (m < |out|) ==> out[m].attention.broadcast?)
    invariant forall m: int :: ((0 <= m) ==> (m < |out|) ==> fromCatalog(catalog, out[m]))
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> (carries(roster, catalog[k].name) || exists m: int :: ((((0 <= m) && (m < |out|)) && (out[m].name == catalog[k].name)) && (out[m].identity == catalog[k].identity))))
  {
    var head := (if ((0 <= i) && (i < |catalog|)) then catalog[i] else Seating("", "", Attention.broadcast));
    var i_t2 := carries(roster, head.name);
    if !(i_t2) {
      ghost var before: seq<Seating> := out;
      var i_t3 := atBroadcast(head);
      out := (out + [i_t3]);
      assert forall m: int :: ((0 <= m) ==> (m < |before|) ==> (out[m] == before[m]));
      assert ((out[|before|].name == head.name) && (out[|before|].identity == head.identity));
    }
    i := (i + 1);
  }
  return out;
}

method without(roster: seq<Seating>, name: string) returns (res: seq<Seating>)
  ensures forall i: int :: ((0 <= i) ==> (i < |res|) ==> (res[i].name != name))
  ensures forall i: int :: ((0 <= i) ==> (i < |res|) ==> (res[i] in roster))
  ensures forall k: int :: ((0 <= k) ==> (k < |roster|) ==> (roster[k].name != name) ==> exists i: int :: (((0 <= i) && (i < |res|)) && (res[i] == roster[k])))
  ensures ((forall i: int, j: int :: ((0 <= i) ==> (i < j) ==> (j < |roster|) ==> (roster[i].name != roster[j].name))) ==> forall i: int, j: int :: ((0 <= i) ==> (i < j) ==> (j < |res|) ==> (res[i].name != res[j].name)))
  ensures (|res| <= |roster|)
{
  var out: seq<Seating> := [];
  var i := 0;
  while (i < |roster|)
    invariant (0 <= i)
    invariant (i <= |roster|)
    invariant (|out| <= i)
    invariant forall m: int :: ((0 <= m) ==> (m < |out|) ==> (out[m].name != name))
    invariant forall m: int :: ((0 <= m) ==> (m < |out|) ==> exists k: int :: (((0 <= k) && (k < i)) && (roster[k] == out[m])))
    invariant forall m: int :: ((0 <= m) ==> (m < |out|) ==> (out[m] in roster))
    invariant forall k: int :: ((0 <= k) ==> (k < i) ==> (roster[k].name != name) ==> exists m: int :: (((0 <= m) && (m < |out|)) && (out[m] == roster[k])))
    invariant ((forall a: int, b: int :: ((0 <= a) ==> (a < b) ==> (b < |roster|) ==> (roster[a].name != roster[b].name))) ==> forall m: int, n: int :: ((0 <= m) ==> (m < n) ==> (n < |out|) ==> (out[m].name != out[n].name)))
  {
    var head := (if ((0 <= i) && (i < |roster|)) then roster[i] else Seating("", "", Attention.broadcast));
    if (head.name != name) {
      ghost var before: seq<Seating> := out;
      out := (out + [head]);
      assert forall m: int :: ((0 <= m) ==> (m < |before|) ==> (out[m] == before[m]));
      assert (out[|before|] == head);
    }
    i := (i + 1);
  }
  return out;
}

method reseated(roster: seq<Seating>, change: Membership) returns (res: seq<Seating>)
  ensures (match change { case other => (res == roster) case _ => true })
  ensures (match change { case unseated(i_change_name) => !(carries(res, i_change_name)) case _ => true })
  ensures (match change { case seated(i_change_name, i_change_identity, i_change_attention) => ((((|res| >= 1) && (res[(|res| - 1)].name == i_change_name)) && (res[(|res| - 1)].identity == i_change_identity)) && (res[(|res| - 1)].attention == i_change_attention)) case _ => true })
  ensures (match change { case seated(i_change_name, i_change_identity, i_change_attention) => forall i: int :: ((0 <= i) ==> (i < (|res| - 1)) ==> (res[i].name != i_change_name)) case _ => true })
  ensures ((!change.other?) ==> forall i: int :: ((0 <= i) ==> (i < |res|) ==> (res[i].name != change.name) ==> (res[i] in roster)))
  ensures ((!change.other?) ==> forall k: int :: ((0 <= k) ==> (k < |roster|) ==> (roster[k].name != change.name) ==> exists i: int :: (((0 <= i) && (i < |res|)) && (res[i] == roster[k]))))
  ensures ((forall i: int, j: int :: ((0 <= i) ==> (i < j) ==> (j < |roster|) ==> (roster[i].name != roster[j].name))) ==> forall i: int, j: int :: ((0 <= i) ==> (i < j) ==> (j < |res|) ==> (res[i].name != res[j].name)))
{
  match change {
    case other =>
      return roster;
    case _ =>
      var i_t4 := without(roster, change.name);
      var rest := i_t4;
      match change {
        case unseated(i_change_name) =>
          return rest;
        case _ =>
          var seat := Seating(change.name, change.identity, change.attention);
          var out := (rest + [seat]);
          assert forall m: int :: ((0 <= m) ==> (m < |rest|) ==> (out[m] == rest[m]));
          assert (out[|rest|] == seat);
          return out;
      }
  }
}

method foldRoster(agents: seq<Seating>, changes: seq<RosterChange>, compositionSeq: int) returns (res: seq<Seating>)
  ensures ((forall i: int :: ((0 <= i) ==> (i < |changes|) ==> (!(afterComposition(changes[i].seq_, compositionSeq)) || changes[i].membership.other?))) ==> (res == agents))
  ensures ((forall i: int, j: int :: ((0 <= i) ==> (i < j) ==> (j < |agents|) ==> (agents[i].name != agents[j].name))) ==> forall i: int, j: int :: ((0 <= i) ==> (i < j) ==> (j < |res|) ==> (res[i].name != res[j].name)))
{
  var roster := agents;
  var i := 0;
  while (i < |changes|)
    invariant (0 <= i)
    invariant (i <= |changes|)
    invariant ((forall k: int :: ((0 <= k) ==> (k < i) ==> (!(afterComposition(changes[k].seq_, compositionSeq)) || changes[k].membership.other?))) ==> (roster == agents))
    invariant ((forall a: int, b: int :: ((0 <= a) ==> (a < b) ==> (b < |agents|) ==> (agents[a].name != agents[b].name))) ==> forall m: int, n: int :: ((0 <= m) ==> (m < n) ==> (n < |roster|) ==> (roster[m].name != roster[n].name)))
  {
    var change := (if ((0 <= i) && (i < |changes|)) then changes[i] else RosterChange(0, Membership.other));
    var i_t5 := afterComposition(change.seq_, compositionSeq);
    if i_t5 {
      roster := reseated(roster, change.membership);
    }
    i := (i + 1);
  }
  return roster;
}

method distinct(names: seq<string>) returns (res: bool)
  ensures (res <==> forall i: int :: ((0 <= i) ==> (i < |names|) ==> forall j: int :: ((0 <= j) ==> (j < i) ==> (names[i] != names[j]))))
{
  var i := 0;
  while (i < |names|)
    invariant (0 <= i)
    invariant (i <= |names|)
    invariant forall a: int :: ((0 <= a) ==> (a < i) ==> forall b: int :: ((0 <= b) ==> (b < a) ==> (names[a] != names[b])))
  {
    var j := 0;
    while (j < i)
      invariant (0 <= j)
      invariant (j <= i)
      invariant forall b: int :: ((0 <= b) ==> (b < j) ==> (names[i] != names[b]))
    {
      if (names[i] == names[j]) {
        return false;
      }
      j := (j + 1);
    }
    i := (i + 1);
  }
  return true;
}
