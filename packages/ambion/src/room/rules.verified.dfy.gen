  requires (reach <= 3)
  ensures (named ==> wakes(attention, named, reach))
  ensures (!(named) ==> (reach == 0) ==> !(wakes(attention, named, reach)))
  ensures (!(named) ==> (reach == 1) ==> !(wakes(attention, named, reach)))
