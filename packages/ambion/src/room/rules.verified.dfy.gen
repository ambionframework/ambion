  ensures (kind.said? ==> directed ==> (reachOf(kind, directed) == 1))
  ensures (kind.said? ==> !(directed) ==> (reachOf(kind, directed) == 2))
  ensures ((!kind.said?) ==> (!kind.summary?) ==> (reachOf(kind, directed) == 3))
