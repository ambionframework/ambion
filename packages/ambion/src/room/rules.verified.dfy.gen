}

function sameName(a: Option<string>, b: Option<string>): bool
{
  match a {
    case Some(i_a_val) =>
      match b {
        case Some(i_b_val) =>
          (i_a_val == i_b_val)
        case None =>
          false
      }
    case None =>
      match b {
        case Some(i_) =>
          false
        case None =>
          true
      }
  }
}

lemma sameName_ensures(a: Option<string>, b: Option<string>)
