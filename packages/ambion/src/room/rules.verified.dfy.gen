  ensures (mayClose(stopped, endings, exchangeOpen, exchangeLive) ==> !(exchangeLive))
  ensures (!(stopped) ==> (endings == 0) ==> exchangeOpen ==> !(exchangeLive) ==> mayClose(stopped, endings, exchangeOpen, exchangeLive))
