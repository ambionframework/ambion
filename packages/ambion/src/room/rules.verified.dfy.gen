  ensures (closeMoved(open, close, lastSeq, exchangeLive) ==> !(admitsClose(open, close, lastSeq, exchangeLive)))
  ensures (admitsClose(open, close, lastSeq, exchangeLive) ==> !(closeMoved(open, close, lastSeq, exchangeLive)))
