  requires (seq_ >= 1)
  ensures (lease.running? ==> answers(lease, seq_))
  ensures (lease.ended? ==> cameToNothing(lease.reason) ==> !(answers(lease, seq_)))
  ensures (lease.ended? ==> lease.reason.released? ==> (answers(lease, seq_) <==> (lease.readThrough >= seq_)))
