  ensures ((reach == 1) ==> wokenBy(seat, author, target, reach, busy) ==> isNamed(target, seat.name))
  ensures ((reach == 0) ==> wokenBy(seat, author, target, reach, busy) ==> isNamed(target, seat.name))
