}

function closeMoved(open: Option<OpenExchange>, close: CloseRef, lastSeq: int, exchangeLive: bool): bool
{
  match open {
    case Some(i_open_val) =>
      ((i_open_val.from == close.from) && ((lastSeq != close.through) || exchangeLive))
    case None =>
