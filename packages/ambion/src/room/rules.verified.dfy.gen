function schedule(unsuccessful: int, last: int, backoff: int): Schedule
  requires (unsuccessful >= 0)
  requires (last >= 0)
{
  Schedule(nextAttempt(unsuccessful), (if (unsuccessful == 0) then Option.None else Option.Some((last + backoff))))
}

