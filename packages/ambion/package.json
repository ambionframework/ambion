{
	"name": "@ambionframework/ambion",
	"version": "0.4.0",
	"type": "module",
	"description": "The collaboration kernel for agents and humans: rooms, the journal vocabulary, the rules, and the room driver.",
	"license": "Apache-2.0",
	"homepage": "https://ambionframework.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ambionframework/ambion.git",
		"directory": "packages/ambion"
	},
	"keywords": [
		"agents",
		"collaboration",
		"journal",
		"kernel",
		"rooms"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./hosting": {
			"types": "./dist/hosting.d.mts",
			"import": "./dist/hosting.mjs"
		},
		"./conformance": {
			"types": "./dist/conformance.d.mts",
			"import": "./dist/conformance.mjs"
		},
		"./testing": {
			"types": "./dist/testing.d.mts",
			"import": "./dist/testing.mjs"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"check:types": "tsc -p tsconfig.check.json --noEmit",
		"test": "vitest run",
		"test:live": "pnpm --filter '@ambionframework/ambion...' --filter '@ambionframework/codex...' build && vitest run --config vitest.live.config.ts",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "^0.99.2",
		"@earendil-works/pi-ai": "^0.99.2",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@ambionframework/journal": "workspace:*",
		"typebox": "^1.3.34"
	}
}
