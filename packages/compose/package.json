{
	"name": "@ambionframework/compose",
	"version": "0.6.0",
	"type": "module",
	"description": "The evaluators of the compose tool for Ambion: quickjsEvaluator() in QuickJS, and processEvaluator() in a child Node process.",
	"license": "Apache-2.0",
	"homepage": "https://ambionframework.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ambionframework/ambion.git",
		"directory": "packages/compose"
	},
	"keywords": [
		"agents",
		"ambion",
		"compose",
		"evaluator",
		"quickjs",
		"sandbox"
	],
	"exports": {
		"./runtime": {
			"types": "./dist/runtime.d.mts",
			"import": "./dist/runtime.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"check:types": "tsc -p tsconfig.check.json --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@ambionframework/ambion": "workspace:*",
		"quickjs-emscripten": "0.32.0"
	},
	"devDependencies": {
		"tsdown": "^0.23.0",
		"typebox": "^1.3.34",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	}
}
