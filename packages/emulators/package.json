{
	"name": "@ambionframework/emulators",
	"version": "0.1.0",
	"type": "module",
	"description": "In-process, pure-TypeScript reimplementations of real tools, bound as Ambion workspace backends. just-bash today.",
	"license": "Apache-2.0",
	"homepage": "https://ambionframework.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ambionframework/ambion.git",
		"directory": "packages/emulators"
	},
	"keywords": [
		"agents",
		"ambion",
		"emulator",
		"filesystem",
		"sandbox",
		"workspace"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"README.md"
	],
	"engines": {
		"node": ">=26.4.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"check:types": "tsc -p tsconfig.check.json --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:live": "vitest run --config vitest.live.config.ts"
	},
	"devDependencies": {
		"@ambionframework/ambion": "workspace:*",
		"@ambionframework/pi": "workspace:*",
		"@earendil-works/pi-ai": "^0.85.1",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@ambionframework/workspace": "workspace:*",
		"@earendil-works/pi-agent-core": "^0.85.1",
		"just-bash": "^3.4.2",
		"typebox": "^1.3.18"
	}
}
