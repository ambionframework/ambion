{
	"name": "ambion",
	"type": "module",
	"private": true,
	"license": "Apache-2.0",
	"packageManager": "pnpm@10.20.0",
	"engines": {
		"node": ">=22.19.0",
		"pnpm": ">=10 <11"
	},
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"test": "turbo test",
		"check": "turbo run build check:types && pnpm run check:lint && turbo run test",
		"check:lint": "biome lint . --error-on-warnings && knip",
		"check:format": "prettier . --cache --check",
		"check:knip": "knip",
		"check:types": "turbo run check:types",
		"format": "pnpm run format:lint && pnpm run format:style",
		"format:lint": "biome check . --write",
		"format:style": "prettier . --cache --write --list-different",
		"version:set": "node scripts/version.mjs",
		"publish:packages": "node scripts/publish.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@types/node": "^26.2.0",
		"knip": "^6.33.0",
		"prettier": "^3.9.6",
		"turbo": "^2.10.12",
		"typescript": "^7.0.2"
	}
}
