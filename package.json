{
	"name": "ambion",
	"type": "module",
	"private": true,
	"license": "Apache-2.0",
	"packageManager": "pnpm@10.20.0",
	"engines": {
		"node": ">=22.19.0",
		"pnpm": ">=10 <11"
	},
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"test": "pnpm run test:reports && pnpm run test:packages",
		"test:reports": "node --test --test-timeout=60000 --test-reporter=dot scripts/*.test.mjs",
		"test:packages": "turbo run test --continue=dependencies-successful",
		"test:live": "pnpm -r run test:live",
		"test:live-local-workstation": "bash scripts/live-local-workstation.sh",
		"chaos": "AMBION_CHAOS=all AMBION_SEEDS=200 pnpm --filter @ambionframework/ambion exec vitest run test/chaos.test.ts test/hosts.test.ts test/property.test.ts test/consistency.test.ts test/split.test.ts test/projection-equivalence.test.ts",
		"check": "node scripts/check.mjs",
		"check:format": "prettier . --cache --check --log-level warn",
		"check:lint": "biome lint . --error-on-warnings --reporter=concise",
		"check:knip": "knip --no-progress",
		"check:types": "turbo run check:types --continue=dependencies-successful",
		"check:lemmascript": "lsc check --backend=dafny && ./check-extra.sh",
		"check:lemmascript:gen": "lsc gen-check --backend=dafny && sh scripts/rules-fresh.sh",
		"check:packages": "node scripts/package-hygiene.mjs",
		"rule:check": "sh scripts/rule-check.sh",
		"format": "pnpm run format:lint && pnpm run format:style",
		"format:lint": "biome check . --write",
		"format:style": "prettier . --cache --write --list-different",
		"version:set": "node scripts/version.mjs",
		"publish:packages": "node scripts/publish.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/node": "^26.6.3",
		"@vitest/coverage-v8": "^4.1.11",
		"knip": "^6.38.0",
		"lemmascript": "0.6.4",
		"prettier": "^3.9.9",
		"turbo": "^2.11.5",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	}
}
