{
	"name": "ambion",
	"type": "module",
	"private": true,
	"license": "Apache-2.0",
	"packageManager": "pnpm@10.20.0",
	"engines": {
		"node": ">=22.19.0",
		"pnpm": ">=10 <11"
	},
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"test": "turbo test",
		"check": "turbo run build check:types && pnpm run check:lint && turbo run test",
		"check:lint": "oxlint --deny-warnings && knip",
		"check:format": "oxfmt --check .",
		"check:knip": "knip",
		"check:types": "turbo run check:types",
		"format": "pnpm run format:lint && pnpm run format:style",
		"format:lint": "oxlint --fix",
		"format:style": "oxfmt .",
		"version:set": "node scripts/version.mjs",
		"publish:packages": "node scripts/publish.mjs"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"knip": "^6.32.2",
		"oxfmt": "^0.65.0",
		"oxlint": "^1.80.0",
		"turbo": "^2.10.11",
		"typescript": "^7.0.2"
	}
}
