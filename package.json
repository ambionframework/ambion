{
	"name": "ambion",
	"type": "module",
	"private": true,
	"license": "Apache-2.0",
	"packageManager": "pnpm@10.20.0",
	"engines": {
		"node": ">=26.4.0",
		"pnpm": ">=10 <11"
	},
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"test": "pnpm run test:reports && turbo test",
		"test:reports": "node --test scripts/report-log.test.mjs scripts/docs-wrap.test.mjs",
		"test:live": "pnpm -r run test:live",
		"chaos": "AMBION_CHAOS=all AMBION_SEEDS=200 pnpm --filter @ambionframework/ambion exec vitest run test/chaos.test.ts test/hosts.test.ts test/property.test.ts test/consistency.test.ts test/split.test.ts",
		"check": "pnpm run check:format && turbo run build check:types && pnpm run check:lint && pnpm run check:lemmascript:gen && pnpm run test:reports && turbo run test",
		"check:lint": "biome lint . --error-on-warnings && knip",
		"check:format": "prettier . --cache --check",
		"check:knip": "knip",
		"check:lemmascript": "lsc check --backend=dafny && ./check-extra.sh",
		"rule:check": "sh scripts/rule-check.sh",
		"check:lemmascript:gen": "lsc gen-check --backend=dafny",
		"check:types": "turbo run check:types",
		"format": "pnpm run format:lint && pnpm run format:style",
		"format:lint": "biome check . --write",
		"format:style": "prettier . --cache --write --list-different",
		"version:set": "node scripts/version.mjs",
		"publish:packages": "node scripts/publish.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@types/node": "^26.2.0",
		"knip": "^6.32.2",
		"lemmascript": "0.6.1",
		"prettier": "^3.9.6",
		"turbo": "^2.10.11",
		"typescript": "^7.0.2"
	}
}
