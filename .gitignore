# build output
dist/
*.tsbuildinfo

# coverage reports, produced on demand by vitest --coverage
coverage/

# dependencies
node_modules/

# caches
.cache/
.turbo/

# logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# environment variables
.env
.env.local
.env.*.local
.dev.vars

# Local registry credentials. The committed root .npmrc holds no token.
.npmrc.local

# editors
.idea/
.vscode/settings.json
*.code-workspace

# macOS
.DS_Store

# wrangler local state
.wrangler/
worker-configuration.d.ts

# Release tarballs, produced by scripts/publish.mjs
dist-release/

# One scripted run's own JSON, produced by an example's demo.ts. Disposable.
examples/*/demo-run.json

# local secrets and ad-hoc end-to-end scripts
.e2e/

# LemmaScript merge scratch, left by `lsc regen` when a merge or a proof fails
*.dfy.base
*.dfy.merged
