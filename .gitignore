# build output
dist/
*.tsbuildinfo

# dependencies
node_modules/

# caches
.cache/
.turbo/

# logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# environment variables
.env
.env.local
.env.*.local
.dev.vars

# Local registry credentials. The committed root .npmrc carries only the
# @ambionframework -> GitHub Packages scope mapping; tokens live here.
.npmrc.local

# editors
.idea/
.vscode/settings.json
*.code-workspace

# macOS
.DS_Store

# wrangler local state
.wrangler/
worker-configuration.d.ts

# Release tarballs, produced by scripts/publish.mjs
dist-release/

# One scripted run's own JSON, produced by an example's demo.ts. Disposable:
# a dated report under demos/ is what a branch checks in, built from this.
examples/*/demo-run.json

# local secrets and ad-hoc end-to-end scripts
.e2e/
