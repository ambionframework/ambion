{
	"$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			// A complexity budget, enforced rather than reported. Biome ships this
			// rule at `info` with a threshold of 15, which is a number nothing
			// checks; 10 is the bar this repository actually holds, and it is an
			// error like every other rule here.
			"complexity": {
				"noExcessiveCognitiveComplexity": {
					"level": "error",
					"options": { "maxAllowedComplexity": 10 }
				}
			},
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error",
				// Source imports use bundler-resolved `.ts` specifiers, which this
				// rule reads as a missing extension.
				"useImportExtensions": "off"
			},
			"style": {
				"useNodejsImportProtocol": "error",
				"noNonNullAssertion": "error",
				"noInferrableTypes": "off"
			},
			"suspicious": {
				"noExplicitAny": "error",
				// The CLI and the examples are console programs; `noConsole` is
				// re-enabled for library source in the override below.
				"noConsole": "off"
			}
		}
	},
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	},
	"files": {
		// Generated demo snapshots are captures, not source.
		"includes": ["**", "!demos"]
	},
	// Formatting is Prettier's job (see prettier.config.js); Biome lints only.
	"formatter": {
		"enabled": false
	},
	"overrides": [
		{
			"includes": ["**/tsconfig.json", "**/tsconfig.*.json"],
			"json": {
				"parser": {
					"allowComments": true,
					"allowTrailingCommas": true
				}
			}
		},
		{
			// The library must not write to stdout on its owner's behalf; hosts
			// pass a logger in instead. It also runs on any host: nothing in it
			// reaches a platform's own modules.
			"includes": ["packages/ambion/src/**"],
			"linter": {
				"rules": {
					"suspicious": { "noConsole": "error" },
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["cloudflare:*", "node:sqlite"],
										"message": "The core runs on any host. A platform's own modules belong to its package."
									}
								]
							}
						}
					}
				}
			}
		},
		// The core is laid out in layers, and an import points down only:
		//
		//   types, wire, define, render   the vocabulary: shapes, and what a participant reads
		//   host/                         what a host owns: the runtime value
		//   journal/                      the room's kinds, over @ambionframework/journal
		//   room/                         every fact and every decision, pure over the journal
		//   tools/                        the workspace port, and the hands over it
		//   seat/                         the seat side of the wire: one activation at a time
		//   session.ts                    the room, which composes them all
		//
		// `docs/toolchain.md` §1 names the layers; each override below refuses
		// the imports its layer may not make.
		{
			"includes": [
				"packages/ambion/src/types.ts",
				"packages/ambion/src/wire.ts",
				"packages/ambion/src/define.ts",
				"packages/ambion/src/render.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"./host/*",
											"./journal/*",
											"./room/*",
											"./tools/*",
											"./seat/*",
											"./session.ts",
											"./index.ts"
										],
										"message": "The vocabulary imports nothing that does anything."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/ambion/src/host/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"../journal/*",
											"../room/*",
											"../tools/*",
											"../seat/*",
											"../session.ts",
											"../index.ts"
										],
										"message": "A host owns values; it reads no log, folds nothing, and runs no seat."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/ambion/src/journal/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"../host/*",
											"../room/*",
											"../tools/*",
											"../seat/*",
											"../session.ts",
											"../index.ts"
										],
										"message": "The journal names the room's kinds, and nothing that reads them."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/ambion/src/room/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"../host/*",
											"../tools/*",
											"../seat/*",
											"../session.ts",
											"../index.ts"
										],
										"message": "The room's facts and decisions are pure over the log: no host, no tool, no seat."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/ambion/src/tools/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"../journal/*",
											"../room/*",
											"../seat/*",
											"../session.ts",
											"../index.ts"
										],
										"message": "A workspace is what a tool reaches into; it knows no room and no seat."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/ambion/src/seat/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["../journal/*", "../room/*", "../session.ts", "../index.ts"],
										"message": "The seat side reaches its room through the wire alone: no log, no fold, no session."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			// A package outside the core reaches it through its published surface:
			// a host, a workspace backend, and an example alike.
			"includes": [
				"packages/cloudflare/src/**",
				"packages/cli/src/**",
				"packages/workspace/src/**",
				"examples/**/src/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@ambionframework/ambion/*", "**/packages/ambion/src/*"],
										"message": "Reach the core through `@ambionframework/ambion`, never a file inside it."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			// The workspace package's tests reach the core's test support by
			// relative path: it is not published, so no specifier names it. The
			// core's own source is a different matter — `vitest.config.ts` and
			// `tsconfig.check.json` alias the package name to it, so a test reads
			// one module and not two.
			"includes": ["packages/workspace/test/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/ambion/src/**"],
										"message": "Reach the core through `@ambionframework/ambion`; the config aliases it to the source."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			// The record sits below the core: it holds a journal and knows no
			// room, no seat and no agent.
			"includes": ["packages/journal/src/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@ambionframework/*", "**/packages/ambion/**"],
										"message": "The record knows no room. Nothing in this repository sits below it."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			// Biome charges a nested function for the nesting it sits in, so
			// inside `describe` → `it` every branch costs three rather than one.
			// Tests keep a budget — one that has become a program still fails —
			// but it is measured from where a test body actually starts.
			"includes": ["**/test/**"],
			"linter": {
				"rules": {
					"complexity": {
						"noExcessiveCognitiveComplexity": {
							"level": "error",
							"options": { "maxAllowedComplexity": 15 }
						}
					}
				}
			}
		}
	]
}
