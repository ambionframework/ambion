{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			// A complexity budget, enforced rather than reported. Biome ships this
			// rule at `info` with a threshold of 15, which is a number nothing
			// checks; 10 is the bar this repository actually holds, and it is an
			// error like every other rule here.
			"complexity": {
				"noExcessiveCognitiveComplexity": {
					"level": "error",
					"options": { "maxAllowedComplexity": 10 }
				}
			},
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error",
				// Source imports use bundler-resolved `.ts` specifiers, which this
				// rule reads as a missing extension.
				"useImportExtensions": "off"
			},
			"style": {
				"useNodejsImportProtocol": "error",
				"noNonNullAssertion": "error",
				"noInferrableTypes": "off"
			},
			"suspicious": {
				"noExplicitAny": "error",
				// The examples are console programs; `noConsole` is re-enabled
				// for library source in the override below.
				"noConsole": "off"
			}
		}
	},
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	},
	// Formatting is Prettier's job (see prettier.config.js); Biome lints only.
	"formatter": {
		"enabled": false
	},
	"overrides": [
		{
			"includes": ["**/tsconfig.json", "**/tsconfig.*.json"],
			"json": {
				"parser": {
					"allowComments": true,
					"allowTrailingCommas": true
				}
			}
		},
		{
			// The library must not write to stdout on its owner's behalf; hosts
			// pass a logger in instead. It also runs on any host: nothing in it
			// reaches a Node built-in, a platform's own modules, or a model library.
			// A Biome override replaces the options of an earlier one for the same
			// rule, and does not merge them. Each layer override below repeats
			// these two groups beside its own, so a layer file keeps the ban. A
			// group reads as a gitignore pattern, and `*` does not cross `/`, so
			// each group also names its subpaths.
			"includes": ["packages/ambion/src/**"],
			"linter": {
				"rules": {
					"suspicious": { "noConsole": "error" },
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["cloudflare:*", "cloudflare:*/**", "node:*", "node:*/**"],
										"message": "The core runs on any host. A platform's own modules belong to its package."
									},
									{
										"group": [
											"@earendil-works/**",
											"@ambionframework/pi",
											"@ambionframework/pi/**"
										],
										"message": "The core names no model library. An executor package, such as @ambionframework/pi, depends on the core."
									}
								]
							}
						}
					}
				}
			}
		},
		// The core is laid out in layers, and an import points down only.
		// `scripts/core-layers.mjs` holds the table, and the probe test checks
		// these rules against it. Each line names the globs of a layer, then what
		// the layer holds:
		//
		//   activation-id.ts, bodies.ts, bundle.ts, compose-catalog.ts, compose-run.ts, compose-tool.ts, compose.ts, define.ts, errors.ts, record.ts, refs.ts, scheduling.ts, session-facts.ts, tool-call.ts, types.ts  the public shapes, the stored bodies, the record lines, the session facts, and the identity codec
		//   protocol.ts  the wire shapes between the room and a seat
		//   execution/contract.ts  the executor contract: the types between the driver and one running activation
		//   host/**  what a host owns: the runtime value
		//   journal/**  the room's kinds, over @ambionframework/journal
		//   room/**  every fact and every decision, pure over the journal
		//   answers.ts  what the room answers a seat's three calls with
		//   execution/**  the execution side of the wire: driver, rendering, tool bodies, trace
		//   conformance*.ts  the suites that play the room from outside the wire
		//   testing/**  the deterministic test tools, over the vocabulary and the execution side
		//   room-run/**  room.ts (state, phases), core.ts (shared view, no sibling), one file per mechanism
		//   room.ts  the room facade, which composes the layers below it
		//   index.ts, hosting.ts, testing.ts  the published entry files, which reach every layer
		//
		// `docs/toolchain.md` §1 names the layers; each override below refuses
		// the imports its layer may not make. The entry files have no override
		// of their own: the override of `packages/ambion/src/**` refuses the core
		// bans for them.
		{
			// `protocol.ts` sits above the rest of the vocabulary: the journal reads
			// the vocabulary without it. One override holds both, because a
			// self-import pattern in `protocol.ts` matches nothing.
			"includes": [
				"packages/ambion/src/activation-id.ts",
				"packages/ambion/src/bodies.ts",
				"packages/ambion/src/refs.ts",
				"packages/ambion/src/record.ts",
				"packages/ambion/src/types.ts",
				"packages/ambion/src/scheduling.ts",
				"packages/ambion/src/session-facts.ts",
				"packages/ambion/src/tool-call.ts",
				"packages/ambion/src/bundle.ts",
				"packages/ambion/src/compose.ts",
				"packages/ambion/src/compose-catalog.ts",
				"packages/ambion/src/compose-run.ts",
				"packages/ambion/src/compose-tool.ts",
				"packages/ambion/src/protocol.ts",
				"packages/ambion/src/define.ts",
				"packages/ambion/src/errors.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"./host/*",
											"./journal/*",
											"./room/*",
											"./execution/*",
											"./room.ts",
											"./room-run/*",
											"./protocol.ts",
											"./answers.ts",
											"./conformance*",
											"./testing/*",
											"./testing.ts",
											"./index.ts",
											"./hosting.ts"
										],
										"message": "The vocabulary imports nothing that does anything."
									},
									{
										"group": ["cloudflare:*", "cloudflare:*/**", "node:*", "node:*/**"],
										"message": "The core runs on any host. A platform's own modules belong to its package."
									},
									{
										"group": [
											"@earendil-works/**",
											"@ambionframework/pi",
											"@ambionframework/pi/**"
										],
										"message": "The core names no model library. An executor package, such as @ambionframework/pi, depends on the core."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/ambion/src/host/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"../journal/*",
											"../room/*",
											"../execution/*",
											"!../execution/contract.ts",
											"../room.ts",
											"../room-run/*",
											"../answers.ts",
											"../conformance*",
											"../testing/*",
											"../testing.ts",
											"../index.ts",
											"../hosting.ts"
										],
										"message": "A host owns values; it reads no log, folds nothing, and runs no seat."
									},
									{
										"group": ["cloudflare:*", "cloudflare:*/**", "node:*", "node:*/**"],
										"message": "The core runs on any host. A platform's own modules belong to its package."
									},
									{
										"group": [
											"@earendil-works/**",
											"@ambionframework/pi",
											"@ambionframework/pi/**"
										],
										"message": "The core names no model library. An executor package, such as @ambionframework/pi, depends on the core."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/ambion/src/journal/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"../host/*",
											"../protocol.ts",
											"../room/*",
											"../execution/*",
											"../room.ts",
											"../room-run/*",
											"../answers.ts",
											"../conformance*",
											"../testing/*",
											"../testing.ts",
											"../index.ts",
											"../hosting.ts"
										],
										"message": "The journal names the room's kinds, and nothing that reads them."
									},
									{
										"group": ["cloudflare:*", "cloudflare:*/**", "node:*", "node:*/**"],
										"message": "The core runs on any host. A platform's own modules belong to its package."
									},
									{
										"group": [
											"@earendil-works/**",
											"@ambionframework/pi",
											"@ambionframework/pi/**"
										],
										"message": "The core names no model library. An executor package, such as @ambionframework/pi, depends on the core."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/ambion/src/room/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"../host/*",
											"../execution/*",
											"../room.ts",
											"../room-run/*",
											"../answers.ts",
											"../conformance*",
											"../testing/*",
											"../testing.ts",
											"../index.ts",
											"../hosting.ts"
										],
										"message": "The room's facts and decisions are pure over the log: no host, no tool, no seat."
									},
									{
										"group": ["cloudflare:*", "cloudflare:*/**", "node:*", "node:*/**"],
										"message": "The core runs on any host. A platform's own modules belong to its package."
									},
									{
										"group": [
											"@earendil-works/**",
											"@ambionframework/pi",
											"@ambionframework/pi/**"
										],
										"message": "The core names no model library. An executor package, such as @ambionframework/pi, depends on the core."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/ambion/src/answers.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"./execution/*",
											"./host/*",
											"./room.ts",
											"./room-run/*",
											"./conformance*",
											"./testing/*",
											"./testing.ts",
											"./index.ts",
											"./hosting.ts"
										],
										"message": "An answer reads the room: no workspace, no seat, and never the session."
									},
									{
										"group": ["cloudflare:*", "cloudflare:*/**", "node:*", "node:*/**"],
										"message": "The core runs on any host. A platform's own modules belong to its package."
									},
									{
										"group": [
											"@earendil-works/**",
											"@ambionframework/pi",
											"@ambionframework/pi/**"
										],
										"message": "The core names no model library. An executor package, such as @ambionframework/pi, depends on the core."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"packages/ambion/src/execution/**",
				"!packages/ambion/src/execution/contract.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"../journal/*",
											"../room/*",
											"../room.ts",
											"../room-run/*",
											"../answers.ts",
											"../conformance*",
											"../testing/*",
											"../testing.ts",
											"../index.ts",
											"../hosting.ts"
										],
										"message": "The seat side reaches its room through the wire alone: no log, no fold, no session."
									},
									{
										"group": ["cloudflare:*", "cloudflare:*/**", "node:*", "node:*/**"],
										"message": "The core runs on any host. A platform's own modules belong to its package."
									},
									{
										"group": [
											"@earendil-works/**",
											"@ambionframework/pi",
											"@ambionframework/pi/**"
										],
										"message": "The core names no model library. An executor package, such as @ambionframework/pi, depends on the core."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			// The executor contract holds types over the vocabulary and the protocol.
			// It sits in `execution/` and below `host/`, so it imports no other file
			// of that folder.
			"includes": ["packages/ambion/src/execution/contract.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"./*",
											"../host/*",
											"../journal/*",
											"../room/*",
											"../room.ts",
											"../room-run/*",
											"../answers.ts",
											"../conformance*",
											"../testing/*",
											"../testing.ts",
											"../index.ts",
											"../hosting.ts"
										],
										"message": "The executor contract names types over the vocabulary and the protocol, and nothing that does anything."
									},
									{
										"group": ["cloudflare:*", "cloudflare:*/**", "node:*", "node:*/**"],
										"message": "The core runs on any host. A platform's own modules belong to its package."
									},
									{
										"group": [
											"@earendil-works/**",
											"@ambionframework/pi",
											"@ambionframework/pi/**"
										],
										"message": "The core names no model library. An executor package, such as @ambionframework/pi, depends on the core."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			// The conformance suites play the room from outside the wire. They reach
			// the protocol, the executor types, and the driver, and nothing that
			// runs a room.
			"includes": ["packages/ambion/src/conformance*.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"./journal/*",
											"./room/*",
											"./room.ts",
											"./room-run/*",
											"./answers.ts",
											"./testing/*",
											"./testing.ts",
											"./index.ts",
											"./hosting.ts"
										],
										"message": "A conformance suite drives the wire from outside: no log, no fold, no room, no model."
									},
									{
										"group": ["cloudflare:*", "cloudflare:*/**", "node:*", "node:*/**"],
										"message": "The core runs on any host. A platform's own modules belong to its package."
									},
									{
										"group": [
											"@earendil-works/**",
											"@ambionframework/pi",
											"@ambionframework/pi/**"
										],
										"message": "The core names no model library. An executor package, such as @ambionframework/pi, depends on the core."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			// The test tools read the vocabulary, the runtime value and the execution
			// contract. They run no room and name no model library.
			"includes": ["packages/ambion/src/testing/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"../journal/*",
											"../room/*",
											"../room.ts",
											"../room-run/*",
											"../answers.ts",
											"../conformance*",
											"../testing.ts",
											"../index.ts",
											"../hosting.ts"
										],
										"message": "The test tools read the vocabulary and the execution contract, run no room, and name no model library."
									},
									{
										"group": ["cloudflare:*", "cloudflare:*/**", "node:*", "node:*/**"],
										"message": "The core runs on any host. A platform's own modules belong to its package."
									},
									{
										"group": [
											"@earendil-works/**",
											"@ambionframework/pi",
											"@ambionframework/pi/**"
										],
										"message": "The core names no model library. An executor package, such as @ambionframework/pi, depends on the core."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			// The collaboration host uses protocol and room facts. Execution and
			// provider services are composed by the public room facade.
			"includes": ["packages/ambion/src/room-run/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"../execution/*",
											"../conformance*",
											"../testing/*",
											"../testing.ts",
											"../room.ts",
											"../index.ts",
											"../hosting.ts"
										],
										"message": "The room host owns collaboration state; execution services belong to the facade."
									},
									{
										"group": ["cloudflare:*", "cloudflare:*/**", "node:*", "node:*/**"],
										"message": "The core runs on any host. A platform's own modules belong to its package."
									},
									{
										"group": [
											"@earendil-works/**",
											"@ambionframework/pi",
											"@ambionframework/pi/**"
										],
										"message": "The core names no model library. An executor package, such as @ambionframework/pi, depends on the core."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			// `core.ts` holds the view that every mechanism shares, and imports no
			// mechanism. This override repeats every group of the override above,
			// because Biome replaces the options of an earlier override.
			"includes": ["packages/ambion/src/room-run/core.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["./*"],
										"message": "The shared view imports none of the mechanisms."
									},
									{
										"group": [
											"../execution/*",
											"../conformance*",
											"../testing/*",
											"../testing.ts",
											"../room.ts",
											"../index.ts",
											"../hosting.ts"
										],
										"message": "The room host owns collaboration state; execution services belong to the facade."
									},
									{
										"group": ["cloudflare:*", "cloudflare:*/**", "node:*", "node:*/**"],
										"message": "The core runs on any host. A platform's own modules belong to its package."
									},
									{
										"group": [
											"@earendil-works/**",
											"@ambionframework/pi",
											"@ambionframework/pi/**"
										],
										"message": "The core names no model library. An executor package, such as @ambionframework/pi, depends on the core."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			// The facade composes every layer below it. It reaches no suite, no test
			// tool, and no entry file.
			"includes": ["packages/ambion/src/room.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"./conformance*",
											"./testing/*",
											"./testing.ts",
											"./index.ts",
											"./hosting.ts"
										],
										"message": "The facade composes the room: no conformance suite, no test tool, and no entry file."
									},
									{
										"group": ["cloudflare:*", "cloudflare:*/**", "node:*", "node:*/**"],
										"message": "The core runs on any host. A platform's own modules belong to its package."
									},
									{
										"group": [
											"@earendil-works/**",
											"@ambionframework/pi",
											"@ambionframework/pi/**"
										],
										"message": "The core names no model library. An executor package, such as @ambionframework/pi, depends on the core."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			// A package outside the core reaches it through its published surface:
			// a host, a workspace backend, and an example alike.
			"includes": [
				"packages/assistant/src/**",
				"packages/cloudflare/src/**",
				"packages/pi/src/**",
				"packages/claude/src/**",
				"packages/codex/src/**",
				"packages/workspace/src/**",
				"packages/simulator/src/**",
				"examples/**/src/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										// `@ambionframework/ambion/hosting` and `/conformance` are
										// published entries, and the manifest names them. Every other
										// path reaches inside the core. Biome reads each group as a
										// gitignore pattern: `!` excludes one path, and an extglob
										// such as `!(a|b)` matches nothing.
										"group": [
											"@ambionframework/ambion/**",
											"!@ambionframework/ambion/hosting",
											"!@ambionframework/ambion/conformance",
											"**/ambion/src/**"
										],
										"message": "Reach the core through `@ambionframework/ambion` or its `/hosting` or `/conformance` entry, never a file inside it."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			// The Pi test entry reads the verbs and the `Reply` type of the core
			// test entry, and so does the scripted demo of Camera Chat. A Biome override replaces the options of an earlier one
			// for the same rule, so this entry repeats the group above and adds
			// the one path it may reach.
			"includes": ["packages/pi/src/testing.ts", "examples/camera-chat/src/demo.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@ambionframework/ambion/**",
											"!@ambionframework/ambion/hosting",
											"!@ambionframework/ambion/conformance",
											"!@ambionframework/ambion/testing",
											"**/ambion/src/**"
										],
										"message": "Reach the core through `@ambionframework/ambion` or its `/hosting`, `/conformance`, or `/testing` entry, never a file inside it."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			// Resource ownership, and the backend and env types beneath it, are
			// independent of the Ambion tool adapter. They are also neutral: a
			// Biome override matches by file, and replaces rather than merges an
			// earlier override's options for the same rule, so this entry folds
			// in the just-bash restriction below instead of losing it.
			"includes": [
				"packages/workspace/src/resource.ts",
				"packages/workspace/src/resource-entry.ts",
				"packages/workspace/src/backend.ts",
				"packages/workspace/src/git-backend.ts",
				"packages/workspace/src/object-backend.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@ambionframework/*",
											"**/ambion/**",
											"./index.ts",
											"./workspace.ts",
											"./tools.ts"
										],
										"message": "Resources and backends are independent of the Ambion tool adapter."
									},
									{
										"group": ["just-bash", "@ambionframework/just-bash", "**/just-bash/**"],
										"message": "The workspace is neutral. The just-bash backends are the package @ambionframework/just-bash, which depends on this one."
									},
									{
										"group": ["@earendil-works", "@earendil-works/**"],
										"message": "The workspace owns its port. The workspace and its backends import no Pi package."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			// Every other file in this package is neutral too: it loads no
			// just-bash and no just-bash backend. This entry folds in the
			// ambion-internal-reach restriction, which a plain
			// `packages/workspace/src/**` override would otherwise lose for
			// these files: a later override's rule options replace an earlier
			// one's rather than merging with it.
			"includes": [
				"packages/workspace/src/**",
				"!packages/workspace/src/resource.ts",
				"!packages/workspace/src/resource-entry.ts",
				"!packages/workspace/src/backend.ts",
				"!packages/workspace/src/git-backend.ts",
				"!packages/workspace/src/object-backend.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@ambionframework/ambion/**",
											"!@ambionframework/ambion/hosting",
											"!@ambionframework/ambion/conformance",
											"**/ambion/src/**"
										],
										"message": "Reach the core through `@ambionframework/ambion` or its `/hosting` or `/conformance` entry, never a file inside it."
									},
									{
										"group": ["just-bash", "@ambionframework/just-bash", "**/just-bash/**"],
										"message": "The workspace is neutral. The just-bash backends are the package @ambionframework/just-bash, which depends on this one."
									},
									{
										"group": ["@earendil-works", "@earendil-works/**"],
										"message": "The workspace owns its port. The workspace and its backends import no Pi package."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			// The workspace package's tests reach the core's test support by
			// relative path: it is not published, so no specifier names it. The
			// core's own source is a different matter — `vitest.config.ts` and
			// `tsconfig.check.json` alias the package name to it, so a test reads
			// one module and not two.
			"includes": ["packages/workspace/test/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/ambion/src/**"],
										"message": "Reach the core through `@ambionframework/ambion`; the config aliases it to the source."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			// The workstation is a bash backend and a git backend. It reaches the
			// workspace through the root entry, which holds the interface and the
			// environment helpers, through `/resource` for `WorkspaceAgent`, and
			// through `/git` for the name rules and the template helpers. It loads
			// no just-bash, no `node:sqlite`, and no part of the core.
			"includes": ["packages/workstation/src/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@ambionframework/ambion",
											"@ambionframework/ambion/**",
											"**/ambion/**"
										],
										"message": "A workspace backend knows the workspace interface, not the room."
									},
									{
										"group": [
											"@ambionframework/workspace/*",
											"!@ambionframework/workspace/resource",
											"!@ambionframework/workspace/git",
											"**/packages/workspace/**",
											"just-bash",
											"just-bash/**",
											"@ambionframework/just-bash",
											"@ambionframework/just-bash/**",
											"node:sqlite"
										],
										"message": "Reach the workspace through its root entry, `/resource`, or `/git`. The workstation loads no just-bash and no SQLite."
									},
									{
										"group": ["@earendil-works", "@earendil-works/**"],
										"message": "The workspace owns its port. The workspace and its backends import no Pi package."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			// The just-bash backends are a bash backend too. They reach the
			// workspace through the root entry and `/resource`, the same as the
			// workstation, and they are the one package that loads just-bash
			// itself. They load no `node:sqlite` and no part of the core.
			"includes": ["packages/just-bash/src/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@ambionframework/ambion",
											"@ambionframework/ambion/**",
											"**/ambion/**"
										],
										"message": "A workspace backend knows the workspace interface, not the room."
									},
									{
										"group": [
											"@ambionframework/workspace/*",
											"!@ambionframework/workspace/resource",
											"**/packages/workspace/**",
											"**/workspace/src/**",
											"node:sqlite"
										],
										"message": "Reach the workspace through its root entry or `/resource`. A bash backend loads no SQLite."
									},
									{
										"group": ["@earendil-works", "@earendil-works/**"],
										"message": "The workspace owns its port. The workspace and its backends import no Pi package."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			// The git backend of just-bash is a workspace backend too. It reaches
			// the workspace through the root entry, `/resource`, and `/git`, and
			// it loads `just-git` and `node:sqlite` for its server and its
			// storage. The rest of the package loads no `node:sqlite`, so the
			// root entry stays free of it. It loads no just-bash and no part of
			// the core.
			"includes": ["packages/just-bash/src/git/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@ambionframework/ambion",
											"@ambionframework/ambion/**",
											"**/ambion/**"
										],
										"message": "A workspace backend knows the workspace interface, not the room."
									},
									{
										"group": [
											"@ambionframework/workspace/*",
											"!@ambionframework/workspace/resource",
											"!@ambionframework/workspace/git",
											"**/packages/workspace/**",
											"**/workspace/src/**",
											"just-bash",
											"just-bash/**",
											"@ambionframework/just-bash",
											"@ambionframework/just-bash/**"
										],
										"message": "Reach the workspace through its root entry, `/resource`, or `/git`. The git backend loads no just-bash."
									},
									{
										"group": ["@earendil-works", "@earendil-works/**"],
										"message": "The workspace owns its port. The workspace and its backends import no Pi package."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			// The record sits below the core: it holds a journal and knows no
			// room, no seat and no agent.
			"includes": ["packages/journal/src/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@ambionframework/*",
											"@ambionframework/*/**",
											"@earendil-works/pi-*",
											"@earendil-works/pi-*/**",
											"**/ambion/**"
										],
										"message": "The record knows no room. Nothing in this repository sits below it."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			// Biome charges a nested function for the nesting it sits in, so
			// inside `describe` → `it` every branch costs three rather than one.
			// Tests keep a budget — one that has become a program still fails —
			// but it is measured from where a test body actually starts.
			"includes": ["**/test/**"],
			"linter": {
				"rules": {
					"complexity": {
						"noExcessiveCognitiveComplexity": {
							"level": "error",
							"options": { "maxAllowedComplexity": 15 }
						}
					}
				}
			}
		}
	]
}
