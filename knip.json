{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignoreBinaries": ["wrangler"],
	"workspaces": {
		".": {
			"entry": [
				"scripts/{version,publish,report,report-cloudflare,cli-team-smoke,journal-smoke}.mjs"
			],
			"project": ["scripts/*.mjs"]
		},
		"packages/*": {
			"project": ["src/**/*.ts"]
		},
		"examples/persistent": {
			"project": ["src/**/*.ts"]
		},
		"packages/cloudflare": {
			"entry": ["test/worker.ts", "test/**/*.test.ts"],
			"project": ["src/**/*.ts", "test/**/*.ts"],
			"ignoreDependencies": ["cloudflare"]
		}
	}
}
