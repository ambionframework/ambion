{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"entry": ["scripts/{version,publish,report}.mjs"],
			"project": ["scripts/*.mjs"]
		},
		"packages/*": {
			"project": ["src/**/*.ts"]
		},
		"packages/cloudflare": {
			"entry": ["test/worker.ts", "test/**/*.test.ts"],
			"project": ["src/**/*.ts", "test/**/*.ts"],
			"ignoreDependencies": ["cloudflare"]
		}
	}
}
