{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignoreBinaries": ["setsid", "flock"],
	"workspaces": {
		".": {
			"entry": [
				"scripts/{check,version,publish,release,journal-smoke,projection-cost,compose-evidence}.mjs"
			],
			"project": ["scripts/*.mjs"],
			"ignoreDependencies": ["@vitest/coverage-v8", "vitest"]
		},
		"packages/*": {
			"project": ["src/**/*.ts"]
		},
		"examples/workbench": {
			"project": ["src/**/*.ts"]
		},
		"packages/cloudflare": {
			"entry": ["test/**/*.test.ts"],
			"project": ["src/**/*.ts", "test/**/*.ts"],
			"ignoreDependencies": ["cloudflare"]
		},
		"examples/camera-chat": {
			"entry": ["src/main.ts", "templates/camera/main.ts"],
			"project": ["src/**/*.ts", "templates/**/*.ts"]
		}
	}
}
