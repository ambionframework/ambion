{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignoreBinaries": ["wrangler"],
	"workspaces": {
		".": {
			"entry": [
				"scripts/{version,publish,release,cli-team-smoke,journal-smoke,projection-envelope}.mjs"
			],
			"project": ["scripts/*.mjs"]
		},
		"packages/*": {
			"project": ["src/**/*.ts"]
		},
		"packages/claude": {
			"project": ["src/**/*.ts"],
			"ignoreDependencies": ["@ambionframework/journal"]
		},
		"packages/cli": {
			"project": ["src/**/*.ts"],
			"ignoreDependencies": [
				"@ambionframework/cloudflare",
				"@ambionframework/journal",
				"@ambionframework/pi",
				"@cloudflare/workers-types"
			]
		},
		"examples/workbench": {
			"project": ["src/**/*.ts"]
		},
		"packages/cloudflare": {
			"entry": ["test/worker.ts", "test/**/*.test.ts"],
			"project": ["src/**/*.ts", "test/**/*.ts"],
			"ignoreDependencies": ["cloudflare"]
		}
	}
}
