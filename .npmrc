# The @ambionframework scope is published to (and installed from) GitHub
# Packages. Authentication is supplied by CI (see .github/workflows/release.yml)
# or, locally, by a personal access token in ~/.npmrc:
#
#   //npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
@ambionframework:registry=https://npm.pkg.github.com

# Workspace packages depend on each other by `workspace:*`; keep pnpm from
# hoisting them into a shape that hides missing dependency declarations.
link-workspace-packages=true
strict-peer-dependencies=false

# Fail the install on an unsupported Node rather than at some later, more
# confusing point. Every package needs Node >=26.4, the OpenTUI floor.
engine-strict=true
