#!/usr/bin/env node
/**
 * A fake `codex` executable for the tests.
 *
 * The Codex SDK runs `codex exec --experimental-json` once for each turn. It
 * writes the prompt to standard input and reads one JSON event on each line
 * of standard output. This fake speaks that protocol without a model.
 *
 * It reads its scenario from the `AMBION_FAKE` environment variable: a JSON
 * object `{ turns: Action[][] }`, one list of actions for each turn. The
 * thread id names the next turn, so a `resume <id>` run plays the next list.
 *
 * As the real Codex does, it starts the MCP servers that the `--config
 * mcp_servers.<name>.command` and `.args` overrides name, and acts as their
 * client. That is the path the room tools take.
 *
 * Actions:
 * - `{ say: text }`             call the `say` tool once.
 * - `{ sayUntilLanded: text }`  call `say`, and again after a `Not delivered` answer.
 * - `{ usage: { input, output, cacheRead, cacheWrite } }`  report these tokens on the turn.
 * - `{ change: [path] }`        report a completed patch of these paths.
 * - `{ text: string }`          send an agent message.
 * - `{ fail: { text } }`        fail the turn with this text.
 */
import { Client } from '@modelcontextprotocol/sdk/client/index.js';
import { StdioClientTransport } from '@modelcontextprotocol/sdk/client/stdio.js';

const argv = process.argv.slice(2);
const configs = [];
let resume;
for (let at = 0; at < argv.length; at += 1) {
	if (argv[at] === '--config') configs.push(argv[(at += 1)] ?? '');
	if (argv[at] === 'resume') resume = argv[(at += 1)];
}

/** The MCP servers the config names: `{ name: { command, args } }`. */
function serversOf() {
	const servers = {};
	for (const config of configs) {
		const match = /^mcp_servers\.([^.]+)\.(command|args)=(.*)$/s.exec(config);
		if (match === null) continue;
		servers[match[1]] ??= {};
		servers[match[1]][match[2]] = JSON.parse(match[3]);
	}
	return servers;
}

const scenario = JSON.parse(process.env.AMBION_FAKE ?? '{"turns":[]}');
const turn = resume === undefined ? 0 : Number(resume.replace('fake-', ''));
const actions = scenario.turns[turn] ?? [];

const emit = (event) => process.stdout.write(`${JSON.stringify(event)}\n`);
let counter = 0;
const nextId = () => `item_${(counter += 1)}`;
const clients = new Map();

/** The MCP client of one configured server, connected on first use. */
async function clientOf(server) {
	const known = clients.get(server);
	if (known !== undefined) return known;
	const { command, args } = serversOf()[server] ?? {};
	if (command === undefined) throw new Error(`No MCP server named ${server} in the config.`);
	const client = new Client({ name: 'fake-codex', version: '0.0.0' });
	await client.connect(new StdioClientTransport({ command, args, stderr: 'ignore' }));
	await client.listTools();
	clients.set(server, client);
	return client;
}

async function closeClients() {
	for (const client of clients.values()) await client.close().catch(() => {});
}

process.on('SIGTERM', () => {
	void closeClients().finally(() => process.exit(143));
});

/** One call of a tool of the `ambion` server, as the items of a Codex turn. */
async function call(tool, args) {
	const id = nextId();
	const item = { id, type: 'mcp_tool_call', server: 'ambion', tool, arguments: args };
	emit({ type: 'item.started', item: { ...item, status: 'in_progress' } });
	const client = await clientOf('ambion');
	const result = await client.callTool({ name: tool, arguments: args });
	const answer = result.content.map((part) => part.text ?? '').join('');
	emit({
		type: 'item.completed',
		item: result.isError
			? { ...item, status: 'failed', error: { message: answer } }
			: {
					...item,
					status: 'completed',
					result: { content: result.content, structured_content: null },
				},
	});
	return { answer, failed: result.isError === true };
}

async function sayUntilLanded(text) {
	for (let attempt = 0; attempt < 3; attempt += 1) {
		const { answer, failed } = await call('say', { text });
		if (!failed || !answer.startsWith('Not delivered')) return;
	}
}

let usage = { input: 1, output: 1, cacheRead: 0, cacheWrite: 0 };

async function perform(action) {
	if (action.usage !== undefined) usage = { ...usage, ...action.usage };
	if (action.say !== undefined) await call('say', { text: action.say });
	if (action.sayUntilLanded !== undefined) await sayUntilLanded(action.sayUntilLanded);
	if (action.change !== undefined) {
		const changes = action.change.map((path) => ({ path, kind: 'update' }));
		emit({
			type: 'item.completed',
			item: { id: nextId(), type: 'file_change', changes, status: 'completed' },
		});
	}
	if (action.text !== undefined) {
		emit({
			type: 'item.completed',
			item: { id: nextId(), type: 'agent_message', text: action.text },
		});
	}
	if (action.fail !== undefined) {
		emit({ type: 'turn.failed', error: { message: action.fail.text } });
		await closeClients();
		process.exit(1);
	}
}

process.stdin.resume();
await new Promise((resolve) => process.stdin.on('end', resolve));

emit({ type: 'thread.started', thread_id: `fake-${turn + 1}` });
emit({ type: 'turn.started' });
for (const action of actions) await perform(action);
emit({
	type: 'turn.completed',
	usage: {
		// Codex counts cached tokens inside its input tokens.
		input_tokens: usage.input + usage.cacheRead,
		cached_input_tokens: usage.cacheRead,
		cache_write_input_tokens: usage.cacheWrite,
		output_tokens: usage.output,
		reasoning_output_tokens: 0,
	},
});
await closeClients();
