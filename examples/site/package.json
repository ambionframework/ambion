{
	"name": "@ambionframework-examples/site",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"description": "A construction management suite where each product is an agent and several people share the room.",
	"scripts": {
		"start": "node --env-file-if-exists=.env src/main.ts",
		"demo": "node --env-file-if-exists=.env src/demo.ts",
		"dev:cloudflare": "wrangler dev",
		"demo:cloudflare": "node src/demo-cloudflare.ts",
		"seed": "node scripts/drive-seed.mjs",
		"check:types": "tsc --noEmit",
		"test": "node scripts/drive-seed.mjs --check"
	},
	"dependencies": {
		"@ambionframework/ambion": "workspace:*",
		"@ambionframework/journal": "workspace:*",
		"@ambionframework/workspace": "workspace:*",
		"typebox": "^1.3.18"
	},
	"devDependencies": {
		"typescript": "^7.0.2",
		"@ambionframework/cloudflare": "workspace:*",
		"@cloudflare/workers-types": "^5.20260801.0",
		"wrangler": "^4.124.0"
	}
}
