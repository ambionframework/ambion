{
	"name": "@ambionframework-examples/persistent",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"description": "A browser room console with persistent journals and local directory workspaces.",
	"scripts": {
		"start": "node --env-file-if-exists=.env src/main.ts start",
		"resume": "node --env-file-if-exists=.env src/main.ts resume",
		"check:types": "tsc --noEmit",
		"test": "vitest run --exclude 'test/live/**'",
		"test:live": "pnpm --filter '@ambionframework-examples/persistent^...' build && vitest run --config vitest.live.config.ts"
	},
	"dependencies": {
		"@ambionframework/ambion": "workspace:*",
		"@ambionframework/assistant": "workspace:*",
		"@ambionframework/journal": "workspace:*",
		"@ambionframework/workspace": "workspace:*"
	},
	"devDependencies": {
		"typescript": "^7.0.2",
		"vitest": "^4.1.11",
		"@earendil-works/pi-ai": "^0.84.3",
		"@ambionframework/evals": "workspace:*"
	}
}
