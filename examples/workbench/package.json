{
	"name": "@ambionframework-examples/workbench",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"description": "Workbench: an agentic lab workbench that hosts its rooms and shows them in one terminal.",
	"engines": {
		"node": ">=26.4.0"
	},
	"scripts": {
		"start": "node --experimental-ffi --env-file-if-exists=.env src/main.ts",
		"check:types": "tsc --noEmit",
		"test": "vitest run --exclude 'test/live/**' --exclude 'templates/**'",
		"test:live": "pnpm --filter '@ambionframework-examples/workbench^...' build && vitest run --config vitest.live.config.ts"
	},
	"dependencies": {
		"@ambionframework/ambion": "workspace:*",
		"@ambionframework/assistant": "workspace:*",
		"@ambionframework/canvas": "workspace:*",
		"@ambionframework/claude": "workspace:*",
		"@ambionframework/codex": "workspace:*",
		"@ambionframework/journal": "workspace:*",
		"@ambionframework/just-bash": "workspace:*",
		"@ambionframework/pi": "workspace:*",
		"@ambionframework/workspace": "workspace:*",
		"@opentui/core": "0.5.14",
		"typebox": "^1.3.36"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^1.0.4",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	}
}
